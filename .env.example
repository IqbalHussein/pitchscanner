# Copy to .env and adjust. Never commit real secrets.

# --- storage ---------------------------------------------------------------
# 'postgres' for the real system; 'memory' serves the checked-in fixtures with
# no database at all, which is how the offline demo and the tests run.
PITCHSCANNER_STORE=postgres
PITCHSCANNER_DSN=postgresql://pitchscanner:pitchscanner@localhost:5432/pitchscanner

# --- data ------------------------------------------------------------------
# Pinned commit of statsbomb/open-data, so every build ingests the same bytes.
PITCHSCANNER_OPEN_DATA_COMMIT=0067cae166a56aa80b2ef18f61e16158d6a7359a

# --- search ----------------------------------------------------------------
PITCHSCANNER_ENCODING=E1
PITCHSCANNER_INDEX_KIND=hnsw          # hnsw | ivfflat | exact
PITCHSCANNER_HNSW_M=16
PITCHSCANNER_HNSW_EF_CONSTRUCTION=200
PITCHSCANNER_HNSW_EF_SEARCH=80
PITCHSCANNER_IVFFLAT_LISTS=200
PITCHSCANNER_IVFFLAT_PROBES=20
PITCHSCANNER_CANDIDATE_MULTIPLIER=5

# --- outcomes --------------------------------------------------------------
PITCHSCANNER_OUTCOME_WINDOW_S=15
PITCHSCANNER_LOW_CONFIDENCE_N=30
PITCHSCANNER_BOOTSTRAP_RESAMPLES=1000

# --- api -------------------------------------------------------------------
PITCHSCANNER_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
PITCHSCANNER_RATE_LIMIT_PER_MINUTE=120

# --- natural-language filters ---------------------------------------------
# The rule-based parser needs nothing. The fallback is optional and off by
# default; enabling it costs money and adds latency on unmatched text only.
PITCHSCANNER_LLM_FALLBACK=false
PITCHSCANNER_LLM_MODEL=claude-opus-5
# PITCHSCANNER_ANTHROPIC_API_KEY=
